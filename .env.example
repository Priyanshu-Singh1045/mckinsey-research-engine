# Backend environment variables (loaded by backend/db/supabase_client.py)

# Search / AI provider keys used by the research pipeline
GOOGLE_API_KEY=
TAVILY_API_KEY=

# Supabase project (Project Settings > API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the SERVICE ROLE key here (backend only — never expose this in the frontend)
SUPABASE_KEY=
